

# Root filesystem erofs e overlay devono essere built-in (nessun initramfs).
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_LZO=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Il driver Ethernet vendor e' un modulo: ok (udev lo carica da /lib/modules)
CONFIG_AW_STMMAC_ETH=m

# Il kernel vendor non ha bisogno di firma moduli
# CONFIG_MODULE_SIG is not set
# Nome versione pulito
CONFIG_LOCALVERSION="-haos-opi4pro"
